# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit it. In production (Render), set these
# as real environment variables on the service instead of using a file.

DATABASE_URL=
FRONTEND_URL=

# Razorpay (Phase 2 — Core Purchase Flow) — test-mode keys locally, live keys
# in production. Required for a real payment during the client demo — a
# blank value here means checkout will fail at the payment step with a
# clear error, never a fake success (see docs/PROGRESS.md's Phase 2 entry).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Resend (deferred post-demo — see IMPLEMENTATION_PLAN.md's backlog) — transactional email.
RESEND_API_KEY=

# Cloudinary (product images, DECISION-010) — format: cloudinary://api_key:api_secret@cloud_name.
# The `cloudinary` gem reads this automatically; no other config needed.
CLOUDINARY_URL=

# Only needed in production. Rails reads config/master.key locally (gitignored,
# never committed); Render has no access to that file, so the same value must
# be set as the RAILS_MASTER_KEY env var there to decrypt config/credentials.yml.enc.
RAILS_MASTER_KEY=

# Seeded admin accounts (SEED-01) — required for db:seed to create admin
# users; never hardcoded in db/seeds.rb. All 4 must be set for any admin to
# be seeded.
SEED_ADMIN_EMAIL_1=
SEED_ADMIN_EMAIL_2=
SEED_ADMIN_EMAIL_3=
SEED_ADMIN_PASSWORD=
