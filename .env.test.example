# Copy this file to .env.test and fill in real values.
#
# dotenv-rails loads .env.test *before* .env for the test environment
# (and never loads .env.local there), so this is the only way to give the
# test environment its own DATABASE_URL. Without it, .env's DATABASE_URL
# (pointing at the *development* database) silently leaks into every test
# run — dotenv only skips a key it already loaded, it doesn't know which
# environment a value in plain .env "belongs" to.
#
# Must point at demo_ecom_api_test, never demo_ecom_api_development —
# Rails treats the test database as scratch space and wipes/reloads it.
DATABASE_URL=
